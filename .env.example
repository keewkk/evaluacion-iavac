# Copiar este archivo a ".env" (mismo nivel que docker-compose.yml) y
# completar cuando la universidad entregue las API keys de IA.
# docker compose lee automaticamente el archivo ".env" - no hay que tocar
# docker-compose.yml ni el codigo del backend.

# Endpoint compatible con OpenAI (/chat/completions) donde se sirven
# Qwen y Gemma. Ejemplo: https://ia.unab.cl/v1
IA_API_URL=

# API key entregada por la universidad.
IA_API_KEY=

# Nombres exactos de los modelos en ese endpoint (si difieren de estos
# valores por defecto).
IA_MODEL_QWEN=qwen2.5-72b-instruct
IA_MODEL_GEMMA=gemma-2-27b-it
